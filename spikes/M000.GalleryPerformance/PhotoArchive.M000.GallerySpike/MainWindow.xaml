<Window
    x:Class="PhotoArchive.M000.GallerySpike.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="Root" Loaded="Root_Loaded" RowDefinitions="Auto,*">
        <Grid Padding="12" ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel Spacing="2">
                <TextBlock Text="M000 WinUI Gallery Performance Spike" FontSize="20" FontWeight="SemiBold" />
                <TextBlock x:Name="StatusText" Text="Initializing 100,000-item virtual source…" />
                <TextBlock x:Name="SelectionText" Text="Selected: 0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Button Content="25%" Click="Jump25_Click" />
                <Button Content="50%" Click="Jump50_Click" />
                <Button Content="75%" Click="Jump75_Click" />
                <Button Content="End" Click="JumpEnd_Click" />
                <Button Content="Run benchmark" Click="RunBenchmark_Click" />
            </StackPanel>
        </Grid>

        <ItemsView x:Name="GalleryItemsView"
                   Grid.Row="1"
                   SelectionMode="Multiple"
                   SelectionChanged="GalleryItemsView_SelectionChanged">
            <ItemsView.Layout>
                <LinedFlowLayout LineHeight="140"
                                 LineSpacing="6"
                                 MinItemSpacing="6"
                                 ItemsStretch="Fill" />
            </ItemsView.Layout>
            <ItemsView.ItemTemplate>
                <DataTemplate>
                    <Grid Width="{Binding TileWidth}"
                          Height="140"
                          Loaded="AssetTile_Loaded"
                          Unloaded="AssetTile_Unloaded">
                        <Border Background="{Binding ThumbnailBrush}" CornerRadius="6" />
                        <Border VerticalAlignment="Bottom" Background="#AA000000" Padding="6">
                            <StackPanel>
                                <TextBlock Text="{Binding ThumbnailLabel}" Foreground="White" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding FileName}" Foreground="White" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding CaptureDateText}" Foreground="#FFE6E6E6" FontSize="11" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </DataTemplate>
            </ItemsView.ItemTemplate>
        </ItemsView>
    </Grid>
</Window>
