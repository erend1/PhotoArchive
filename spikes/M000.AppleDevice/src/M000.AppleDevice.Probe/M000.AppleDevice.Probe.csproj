<Project Sdk="Microsoft.NET.Sdk">

  <!--
    M000 Apple device capability spike probe.
    Spike-only code: NOT production architecture. See ../../README.md.
    Uses only documented Windows APIs:
      - Windows Portable Devices (WPD) COM API (PortableDeviceApi.dll), via CsWin32-generated
        declarations from Microsoft's Win32 metadata.
      - Windows.Media.Import WinRT API (Windows SDK projection).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>apple-device-probe</AssemblyName>
    <RootNamespace>PhotoArchive.Spikes.AppleDevice</RootNamespace>
    <InvariantGlobalization>false</InvariantGlobalization>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.335">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="M000.AppleDevice.Probe.Tests" />
  </ItemGroup>

</Project>
